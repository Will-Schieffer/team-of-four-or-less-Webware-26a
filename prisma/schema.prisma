generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UtilityCategory {
  GAS
  ELECTRIC
  WATER
  INTERNET
  TRASH
}

model Place {
  zip       String     @id @db.Char(5)
  city      String
  state     String     @db.Char(2)
  lat       Float?
  lng       Float?
  offerings Offering[]

  @@index([city, state])
}

model Provider {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  website   String?
  phone     String?
  offerings Offering[]
}

model Offering {
  id         Int             @id @default(autoincrement())
  zip        String          @db.Char(5)
  providerId Int
  category   UtilityCategory
  price      Float?
  place      Place           @relation(fields: [zip], references: [zip], onDelete: Cascade)
  provider   Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([zip, providerId, category])
  @@index([zip, category])
}

model User {
  id      Int     @id @default(autoincrement())
  clerkId String  @unique
  email   String?
}